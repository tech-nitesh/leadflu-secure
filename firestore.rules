rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes go through the Next.js API routes using the
    // server SDK, which is not restricted by these rules. Client apps must
    // never read raw lead/user documents directly (contact details are
    // masked server-side in /api/leads). Lock everything down.
    match /leads/{leadId} {
      allow read, write: if false;
    }
    match /users/{userId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
